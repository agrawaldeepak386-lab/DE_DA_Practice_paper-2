   "outputs": [],
   "source": [
    "SELECT\n",
    "  station_id,\n",
    "  city,\n",
    "  SUM(completed_sessions)          AS completed_sessions,\n",
    "  SUM(energy_kwh)                  AS energy_kwh,\n",
    "  ROUND(AVG(utilisation_pct), 2)   AS utilisation_pct\n",
    "FROM gold.agg_daily_station\n",
    "GROUP BY station_id, city\n",
    "ORDER BY utilisation_pct DESC;\n"
   ]
  }
 ],
